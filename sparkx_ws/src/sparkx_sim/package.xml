<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sparkx_sim</name>
  <version>1.0.0</version>
  <description>SparkX Gazebo launch, robot spawn and ROS-Gazebo bridges (team vs referee topics).</description>
  <maintainer email="organizers@sparkx.example">SparkX Organizers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>sparkx_description</exec_depend>
  <exec_depend>sparkx_worlds</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
