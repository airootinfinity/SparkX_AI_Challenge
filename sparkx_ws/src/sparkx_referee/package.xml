<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sparkx_referee</name>
  <version>1.0.0</version>
  <description>SparkX referee: mission server, rescue verification, hints, scoring, logs, dashboard.</description>
  <maintainer email="organizers@sparkx.example">SparkX Organizers</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>sparkx_interfaces</depend>
  <depend>sparkx_worlds</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
