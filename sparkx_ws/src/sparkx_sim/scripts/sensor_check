#!/usr/bin/env python3
"""Health check of the rover's sensors in a running SparkX simulation.

  ros2 run sparkx_sim sensor_check [timeout_s]

Fails (exit 1) when a sensor is silent or blind: a black colour image, a depth image with no valid
pixels, a thermal image with no contrast, or an empty LiDAR cloud. Run it after any change to the
robot model: a housing that wraps its own optical centre blinds that camera."""
import sys
import time

import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image, Imu, PointCloud2
from nav_msgs.msg import Odometry


def main():
    timeout = float(sys.argv[1]) if len(sys.argv) > 1 else 40.0
    rclpy.init()
    n = Node('sparkx_sensor_check')
    got = {}

    def rgb(m):
        a = np.frombuffer(m.data, np.uint8)
        got['colour camera'] = (a.max() > 40, f'mean {a.mean():.0f}, max {a.max()}')

    def dep(m):
        a = np.frombuffer(m.data, np.float32)
        f = np.isfinite(a)
        got['depth camera'] = (f.mean() > 0.02, f'{f.mean() * 100:.0f}% valid pixels')

    def th(m):
        a = np.frombuffer(m.data, np.uint16) * 0.01
        got['thermal camera'] = (a.max() > 200.0, f'{a.min():.1f} .. {a.max():.1f} K')

    def li(m):
        got['3D LiDAR'] = (m.width * m.height > 1000, f'{m.width * m.height} points')

    n.create_subscription(Image, '/camera/color/image_raw', rgb, qos_profile_sensor_data)
    n.create_subscription(Image, '/camera/depth/image_raw', dep, qos_profile_sensor_data)
    n.create_subscription(Image, '/thermal/image_raw', th, qos_profile_sensor_data)
    n.create_subscription(PointCloud2, '/lidar/points', li, qos_profile_sensor_data)
    n.create_subscription(Imu, '/imu/data', lambda m: got.__setitem__('IMU', (True, 'publishing')), qos_profile_sensor_data)
    n.create_subscription(Odometry, '/wheel/odom', lambda m: got.__setitem__('wheel odometry', (True, 'publishing')),
                          qos_profile_sensor_data)
    names = ['colour camera', 'depth camera', 'thermal camera', '3D LiDAR', 'IMU', 'wheel odometry']
    t0 = time.time()
    while len(got) < len(names) and time.time() - t0 < timeout:
        rclpy.spin_once(n, timeout_sec=0.2)
    ok = True
    for k in names:
        good, text = got.get(k, (False, 'NO DATA'))
        ok &= good
        print(f'{"OK  " if good else "FAIL"} {k:15s} {text}')
    n.destroy_node()
    rclpy.shutdown()
    sys.exit(0 if ok else 1)


if __name__ == '__main__':
    main()
