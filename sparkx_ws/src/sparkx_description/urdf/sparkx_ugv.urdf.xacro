<?xml version="1.0"?>
<!--
  SparkX Rescue UGV — Husky A200-class 4WD skid-steer platform for urban search & rescue,
  in the Airoot livery (ink body, crimson Airoot mark and light line, off-white edge lines).

  Visuals are the Blender models in meshes/ (rebuild with tools/blender/build_rover.py); the
  collision shapes below are simple boxes that enclose them.

  Platform (Clearpath Husky A200 dimensions): 0.99 x 0.67 x 0.39 m, ~50 kg, 330 mm wheels, 1.0 m/s.
  Sensors (modelled on real hardware):
    * 3D LiDAR   : Ouster OS1-32 class   (32 ch, 360 deg x 45 deg, 10 Hz, 0.3-60 m)
    * RGB-D      : RealSense D455 class  (87 x 58 deg, 640x480 @ 15 Hz, depth 0.3-12 m)
    * Thermal    : FLIR Boson 320 class  (57 deg HFOV, 320x256 @ 9 Hz, 16-bit radiometric, 0.01 K/LSB)
    * IMU        : 9-DoF tactical-grade MEMS (200 Hz)
    * Wheel odometry, bumper contact sensor (referee), LED headlights

  Frames (REP-103/105): base_footprint (ground, root) == base_link (ground level, centre of wheelbase)
  All sensor frames are children of base_link. Camera images use *_optical_frame (z forward).

  xacro args:
    gt_bbox_camera : add a ground-truth bounding-box camera (dataset generation ONLY, never in competition)
    headlights     : add LED spot lights (dark interiors / dusk scenarios)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sparkx_ugv">

  <xacro:arg name="gt_bbox_camera" default="false"/>
  <xacro:arg name="headlights" default="true"/>
  <xacro:arg name="lidar_h_samples" default="1024"/>
  <xacro:arg name="lidar_channels" default="32"/>
  <xacro:arg name="camera_rate" default="15"/>

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- ===== Platform geometry (Husky A200) ===== -->
  <xacro:property name="wheel_radius" value="0.1651"/>
  <xacro:property name="wheel_width" value="0.1143"/>
  <xacro:property name="wheelbase" value="0.512"/>
  <xacro:property name="track" value="0.5708"/>
  <xacro:property name="body_len" value="0.80"/>
  <xacro:property name="body_wid" value="0.44"/>
  <xacro:property name="body_hgt" value="0.22"/>
  <xacro:property name="body_z" value="0.265"/>       <!-- body centre height above ground -->
  <xacro:property name="chassis_mass" value="46.0"/>
  <xacro:property name="wheel_mass" value="2.6"/>

  <!-- Effective skid-steer wheel separation used by the drive controller (tuned in sim, see docs) -->
  <xacro:property name="skid_separation" value="0.95"/>

  <!-- Sensor placement -->
  <xacro:property name="lidar_z" value="0.78"/>
  <xacro:property name="cam_x" value="0.40"/>
  <xacro:property name="cam_z" value="0.52"/>
  <xacro:property name="cam_pitch" value="0.12"/>    <!-- ~7 deg down: see low / lying survivors -->

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <!-- ===== Base ===== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_z}"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${body_len}" y="${body_wid}" z="${body_hgt}"/>
    </inertial>
    <visual name="body">
      <geometry><mesh filename="package://sparkx_description/meshes/rover_base.glb"/></geometry>
    </visual>
    <!-- One collision box enclosing body + bumpers (used by the referee bumper sensor).
         Starts 0.12 m above ground so small debris (< 12 cm) can be driven over. -->
    <collision name="chassis">
      <origin xyz="0 0 0.26"/>
      <geometry><box size="0.99 0.67 0.28"/></geometry>
    </collision>
    <!-- electronics bay on the deck -->
    <collision name="payload">
      <origin xyz="-0.085 0 0.4565"/>
      <geometry><box size="0.44 0.34 0.135"/></geometry>
    </collision>
    <collision name="mast">
      <origin xyz="0 0 ${(body_z + body_hgt/2 + lidar_z)/2}"/>
      <geometry><box size="0.12 0.12 ${lidar_z - body_z - body_hgt/2}"/></geometry>
    </collision>
  </link>

  <!-- ===== Wheels ===== -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                 iyy="${wheel_mass*wheel_radius*wheel_radius/2}" iyz="0"
                 izz="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"/>
      </inertial>
      <visual>
        <!-- the mesh's outer face is +Y; right-hand wheels are turned around -->
        <origin xyz="0 0 0" rpy="0 0 ${0 if y > 0 else PI}"/>
        <geometry><mesh filename="package://sparkx_description/meshes/rover_wheel.glb"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e7</kp>
      <kd>1.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x="${wheelbase/2}" y="${track/2}"/>
  <xacro:wheel prefix="front_right" x="${wheelbase/2}" y="${-track/2}"/>
  <xacro:wheel prefix="rear_left" x="${-wheelbase/2}" y="${track/2}"/>
  <xacro:wheel prefix="rear_right" x="${-wheelbase/2}" y="${-track/2}"/>

  <!-- ===== IMU ===== -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== 3D LiDAR (OS1-32 class) ===== -->
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== RGB-D camera (D455 class) ===== -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 ${cam_pitch} 0"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ===== Thermal camera (Boson 320 class), mounted just above the RGB-D ===== -->
  <link name="thermal_link"/>
  <joint name="thermal_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thermal_link"/>
    <origin xyz="${cam_x} 0 ${cam_z + 0.04}" rpy="0 ${cam_pitch} 0"/>
  </joint>
  <link name="thermal_optical_frame"/>
  <joint name="thermal_optical_joint" type="fixed">
    <parent link="thermal_link"/>
    <child link="thermal_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- ======================== Gazebo (gz-sim 8) ========================== -->
  <!-- ===================================================================== -->

  <!-- Bumper / collision sensor (referee only, bridged on the private domain) -->
  <gazebo reference="base_link">
    <sensor name="bumper" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <!-- name produced by URDF fixed-joint lumping (base_link merged into base_footprint) -->
        <collision>base_footprint_fixed_joint_lump__chassis_collision</collision>
        <collision>base_footprint_fixed_joint_lump__payload_collision_1</collision>
        <collision>base_footprint_fixed_joint_lump__mast_collision_2</collision>
        <topic>/sparkx/robot/bumper</topic>
      </contact>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/sparkx/robot/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean><bias_stddev>0.0001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean><bias_stddev>0.0001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean><bias_stddev>0.0001</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.01</bias_mean><bias_stddev>0.002</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.01</bias_mean><bias_stddev>0.002</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.01</bias_mean><bias_stddev>0.002</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/sparkx/robot/lidar</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>$(arg lidar_h_samples)</samples>
            <resolution>1</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI}</max_angle>
          </horizontal>
          <vertical>
            <samples>$(arg lidar_channels)</samples>
            <resolution>1</resolution>
            <min_angle>-0.3927</min_angle>
            <max_angle>0.3927</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>60.0</max>
          <resolution>0.003</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>$(arg camera_rate)</update_rate>
      <visualize>false</visualize>
      <topic>/sparkx/robot/rgbd</topic>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <camera name="rgbd">
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>700</far>   <!-- far enough to see the sky dome beyond the arena -->
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>12.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="thermal_link">
    <sensor name="thermal" type="thermal_camera">
      <always_on>true</always_on>
      <update_rate>9</update_rate>
      <visualize>false</visualize>
      <topic>/sparkx/robot/thermal/image</topic>
      <gz_frame_id>thermal_optical_frame</gz_frame_id>
      <camera name="thermal">
        <horizontal_fov>0.9948</horizontal_fov>
        <image>
          <width>320</width>
          <height>256</height>
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <camera_info_topic>/sparkx/robot/thermal/camera_info</camera_info_topic>
      </camera>
      <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
        <min_temp>253.15</min_temp>
        <max_temp>653.15</max_temp>
        <resolution>0.01</resolution>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Organiser chase camera: a third-person view that follows the rover, used by
       `ros2 run sparkx_sim record_mission` to film a run. It is never bridged to teams, and Gazebo
       only renders it while something is subscribed, so it costs nothing in a normal run. -->
  <gazebo reference="base_link">
    <sensor name="chase_cam" type="camera">
      <pose>-3.4 0 2.15 0 0.40 0</pose>
      <always_on>true</always_on>
      <update_rate>12</update_rate>
      <topic>/sparkx/referee_private/chase_cam</topic>
      <camera name="chase_cam">
        <horizontal_fov>1.25</horizontal_fov>
        <image><width>960</width><height>540</height><format>R8G8B8</format></image>
        <clip><near>0.2</near><far>900</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg gt_bbox_camera)">
    <gazebo reference="camera_link">
      <sensor name="gt_boxes" type="boundingbox_camera">
        <always_on>true</always_on>
        <update_rate>$(arg camera_rate)</update_rate>
        <topic>/sparkx/dataset/boxes</topic>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <camera name="gt_boxes">
          <box_type>visible_2d</box_type>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>60</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg headlights)">
    <gazebo reference="base_link">
      <light name="headlight_left" type="spot">
        <pose>0.42 0.155 0.318 0 0.22 0</pose>
        <diffuse>1.0 0.97 0.9 1</diffuse>
        <specular>0.3 0.3 0.3 1</specular>
        <attenuation>
          <range>18</range>
          <constant>0.3</constant>
          <linear>0.05</linear>
          <quadratic>0.01</quadratic>
        </attenuation>
        <direction>1 0 0</direction>
        <spot>
          <inner_angle>0.5</inner_angle>
          <outer_angle>0.9</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <cast_shadows>false</cast_shadows>
        <intensity>1.5</intensity>
      </light>
      <light name="headlight_right" type="spot">
        <pose>0.42 -0.155 0.318 0 0.22 0</pose>
        <diffuse>1.0 0.97 0.9 1</diffuse>
        <specular>0.3 0.3 0.3 1</specular>
        <attenuation>
          <range>18</range>
          <constant>0.3</constant>
          <linear>0.05</linear>
          <quadratic>0.01</quadratic>
        </attenuation>
        <direction>1 0 0</direction>
        <spot>
          <inner_angle>0.5</inner_angle>
          <outer_angle>0.9</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <cast_shadows>false</cast_shadows>
        <intensity>1.5</intensity>
      </light>
    </gazebo>
  </xacro:if>

  <!-- ===== Model-level systems ===== -->
  <gazebo>
    <!-- Skid-steer drive. Commands arrive ONLY through the referee gate (/sparkx/robot/cmd_vel). -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${skid_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <topic>/sparkx/robot/cmd_vel</topic>
      <odom_topic>/sparkx/robot/wheel_odom</odom_topic>
      <tf_topic>/sparkx/robot/wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/sparkx/robot/joint_states</topic>
    </plugin>

    <!-- Ground-truth pose for the referee (private domain only; NEVER bridged to teams) -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>sparkx_ugv</robot_base_frame>
      <odom_topic>/sparkx/gt/odometry</odom_topic>
      <tf_topic>/sparkx/gt/tf</tf_topic>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>
</robot>
