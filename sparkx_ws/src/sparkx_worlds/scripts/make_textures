#!/usr/bin/env python3
"""Regenerate the procedural SparkX textures. usage: make_textures [out_dir]"""
import os
import sys

from sparkx_worlds.textures import generate_all

if __name__ == '__main__':
    out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), '..', 'models',
                                                             'sparkx_media', 'textures')
    names = generate_all(os.path.abspath(out))
    print(f'generated {len(names)} textures in {os.path.abspath(out)}')
