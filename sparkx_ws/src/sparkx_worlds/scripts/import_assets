#!/usr/bin/env python3
"""(Re)import the Gazebo Fuel assets used by SparkX into a models directory.
usage: import_assets [models_dir]   (default: <source>/sparkx_worlds/models)"""
import os
import sys

from sparkx_worlds.assets import import_assets

if __name__ == '__main__':
    out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), '..', 'models')
    import_assets(os.path.abspath(out))
