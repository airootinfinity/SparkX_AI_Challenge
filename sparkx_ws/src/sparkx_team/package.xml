<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sparkx_team</name>
  <version>1.0.0</version>
  <description>SparkX team package: the four files a team may edit (perception.py, memory.py, mission.py, config/team.yaml) plus a data-only models/ folder. Ships the organisers' reference implementation.</description>
  <maintainer email="organizers@sparkx.example">SparkX Organizers</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>sparkx_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <exec_depend>sparkx_worlds</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
